# OpenRouter API Configuration
VITE_OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Model to use (e.g. google/gemini-2.5-flash, google/gemini-2.5-flash:free, or other vision-capable models)
VITE_OPENROUTER_MODEL=google/gemini-2.5-flash

# Your OpenRouter API Key (Get one at https://openrouter.ai/keys)
VITE_OPENROUTER_API_KEY=
