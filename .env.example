# Default mode when a user first opens the app:
# offline | openrouter | gemini | openai | groq | ollama | custom
VITE_AI_PROVIDER=offline

# NOTE (Security / BYOK):
# Never put API keys in VITE_* environment variables — Vite embeds them into
# the public client-side bundle. Users enter their own API keys (BYOK) in the
# in-app Settings modal, where keys are stored strictly in their own browser's localStorage.
